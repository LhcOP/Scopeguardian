{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",

    "AZURE_TENANT_ID": "<your-tenant-id>",
    "AZURE_CLIENT_ID": "<app-registration-client-id>",
    "AZURE_CLIENT_SECRET": "<app-registration-client-secret — omit to use Managed Identity>",

    "AZURE_STORAGE_CONNECTION_STRING": "DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net",

    "COSMOS_ENDPOINT": "https://<your-account>.documents.azure.com:443/",
    "COSMOS_KEY": "<your-cosmos-primary-key>",

    "AI_SEARCH_ENDPOINT": "https://<your-search-service>.search.windows.net",
    "AI_SEARCH_KEY": "<your-search-admin-key>",

    "AZURE_OPENAI_ENDPOINT": "https://<your-resource>.openai.azure.com/",
    "AZURE_OPENAI_KEY": "<your-aoai-key>",
    "AZURE_OPENAI_API_VERSION": "2024-10-21",
    "AZURE_OPENAI_CHAT_DEPLOYMENT": "gpt-4.1",
    "AZURE_OPENAI_MINI_DEPLOYMENT": "gpt-4.1-mini",
    "AZURE_OPENAI_EMBEDDING_DEPLOYMENT": "text-embedding-3-small",

    "BOT_APP_ID": "<teams-bot-app-id>",
    "BOT_APP_PASSWORD": "<teams-bot-app-password>",
    "BOT_APP_TYPE": "SingleTenant",
    "BOT_SERVICE_URL": "https://smba.trafficmanager.net/teams/",

    "WEBHOOK_CLIENT_STATE": "<generate-a-long-random-secret>",
    "WEBHOOK_NOTIFICATION_URL": "https://<your-function-app>.azurewebsites.net/api/webhook/graph?code=<function-key>",

    "PROJECT_CONFIGS": "project-001:<sharepoint-site-id>:<list-id>,project-002:<site-id>:<list-id>",
    "DEFAULT_PROJECT_ID": "project-001",

    "TEAMS_CHANNEL_ID": "<teams-channel-id e.g. 19:...@thread.tacv2 — empty disables Teams alerts>",

    "ALERT_EMAIL_FROM": "<sender-mailbox-upn — requires Mail.Send application permission>",
    "ALERT_EMAIL_TO": "<recipient1@company.com,recipient2@company.com — empty disables email alerts>",

    "PROJECTS_HUB_SITE_ID": "<graph-site-id of the hub containing the Projects register — enables auto scope generation>",
    "PROJECTS_HUB_LIST": "Projects",
    "SCOPE_DOC_SEARCH": "estimat",

    "TIMETRACK_SITE_ID": "<graph-site-id of the time-tracking hub — enables registered-hours signals>",
    "TIMETRACK_LIST_PREFIX": "Tidsreg"
  }
}
