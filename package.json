{
  "name": "scopeguardian",
  "version": "1.0.0",
  "description": "AI Scope Monitor — event-driven scope creep detection for enterprise projects",
  "main": "dist/src/functions/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "start": "npm run build && func start",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.0",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.3.0",
    "@azure/search-documents": "^12.1.0",
    "@azure/storage-blob": "^12.24.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "botbuilder": "^4.23.0",
    "openai": "^4.52.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@azure/functions": "^4.5.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.9",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
